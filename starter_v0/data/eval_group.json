{
  "dataset_id": "day04_v2_group_team_g34",
  "dataset_role": "group",
  "description": "Bộ 10 eval cases do nhóm G34 tự thiết kế: 5 single-turn + 5 multi-turn đánh giá khả năng routing, xử lý ranh giới, và các tool mới (weather_forecast, currency_convert, crypto_price).",
  "allowed_failure_types": [
    "wrong_tool",
    "wrong_arg_value",
    "wrong_boundary",
    "unnecessary_tool",
    "out_of_scope",
    "missing_info"
  ],
  "cases": [
    {
      "id": "G01_weather_forecast",
      "phase": "B",
      "query": "Thời tiết ở Hà Nội hôm nay thế nào?",
      "failure_type": "wrong_tool",
      "expect": {
        "tool_calls": [
          {
            "name": "weather_forecast",
            "args": {
              "location": "Hanoi"
            }
          }
        ]
      },
      "metadata": {
        "what_it_tests": "Single-turn: Routing đúng vào custom tool weather_forecast với địa điểm Hanoi."
      }
    },
    {
      "id": "G02_currency_convert",
      "phase": "B",
      "query": "Đổi giúp mình 100 USD sang VND.",
      "failure_type": "wrong_tool",
      "expect": {
        "tool_calls": [
          {
            "name": "currency_convert",
            "args": {
              "from_currency": "USD",
              "to_currency": "VND",
              "amount": 100
            }
          }
        ]
      },
      "metadata": {
        "what_it_tests": "Single-turn: Routing đúng vào custom tool currency_convert với đúng tham số USD, VND, 100."
      }
    },
    {
      "id": "G03_crypto_price",
      "phase": "B",
      "query": "Cho mình xem giá Bitcoin hiện tại theo USD.",
      "failure_type": "wrong_tool",
      "expect": {
        "tool_calls": [
          {
            "name": "crypto_price",
            "args": {
              "symbol": "bitcoin",
              "currency": "usd"
            }
          }
        ]
      },
      "metadata": {
        "what_it_tests": "Single-turn: Routing đúng vào custom tool crypto_price cho symbol bitcoin."
      }
    },
    {
      "id": "G04_missing_url_clarify",
      "phase": "B",
      "query": "Đọc giúp mình nội dung bài viết này.",
      "failure_type": "missing_info",
      "expect": {
        "tool_calls": [
          {
            "name": "clarify",
            "args": {
              "response_type": "text"
            }
          }
        ]
      },
      "metadata": {
        "what_it_tests": "Single-turn: Nhận biết thiếu URL bài viết và gọi clarify với response_type=text."
      }
    },
    {
      "id": "G05_confirm_send",
      "phase": "B",
      "query": "Đăng bản tin tổng hợp này lên kênh Telegram.",
      "failure_type": "wrong_boundary",
      "expect": {
        "tool_calls": [
          {
            "name": "clarify",
            "args": {
              "response_type": "yes_no"
            }
          }
        ]
      },
      "metadata": {
        "what_it_tests": "Single-turn: Yêu cầu hành động nhạy cảm đăng tin -> phải xin xác nhận yes/no trước."
      }
    },
    {
      "id": "G06_multi_weather_followup",
      "phase": "B",
      "turns": [
        {
          "role": "user",
