            }
          }
        ]
      },
      "metadata": {
        "what_it_tests": "Multi-turn: Chuyển đổi tên đồng tiền mã hóa từ bitcoin sang ethereum."
      }
    },
    {
      "id": "G09_multi_clarify_then_search",
      "phase": "B",
      "turns": [
        {
          "role": "user",
          "content": "Xem các tweet mới nhất giúp mình"
        },
        {
          "role": "user",
          "content": "Của Sam Altman nhé"
        }
      ],
      "failure_type": "missing_info",
      "expect": {
        "tool_calls": [
          {
            "name": "timeline",
            "args": {
              "screenname": "sama"
            }
          }
        ]
      },
      "metadata": {
        "what_it_tests": "Multi-turn: Lượt 1 thiếu handle -> Lượt 2 bổ sung Sam Altman và map sang handle sama."
      }
    },
    {
      "id": "G10_multi_out_of_scope_reset",
      "phase": "B",
      "turns": [
        {
          "role": "user",
          "content": "Tìm tin AI hôm nay"
        },
        {
          "role": "user",
          "content": "Viết giúp mình một đoạn mã C++ sắp xếp mảng."
